# =============================================================================
# RelayChat — Environment Configuration (.env.example)
# =============================================================================

# --- Branding & Node Identity ---
APP_NAME=RelayChat
APP_DOMAIN=chatapp.in
NODE_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database (MySQL 8 in Docker / Production) ---
MYSQL_ROOT_PASSWORD=relaychat_root_secret
MYSQL_DATABASE=relaychat
MYSQL_USER=relaychat
MYSQL_PASSWORD=relaychat_secret
DATABASE_URL=mysql+aiomysql://relaychat:relaychat_secret@mysql:3306/relaychat

# For local zero-daemon dev/testing without Docker, you can also use:
# DATABASE_URL=sqlite+aiosqlite:///./relaychat.db

# --- JWT & Auth Security ---
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Node Ed25519 Signing Key & Phase 8 S2S Federation ---
NODE_PRIVATE_KEY_B64=
NODE_KEY_PATH=./.node_keys/node_ed25519.json
FEDERATION_ENABLED=true
FEDERATION_REQUIRE_HTTPS=false
FEDERATION_ALLOW_PRIVATE_IPS=false
FEDERATION_HTTP_TIMEOUT_SECONDS=5.0
FEDERATION_USER_CACHE_TTL_SECONDS=300
FEDERATION_SIGNATURE_MAX_SKEW_SECONDS=300
FEDERATION_OUTBOX_POLL_INTERVAL_SECONDS=1.5
FEDERATION_OUTBOX_BASE_DELAY_SECONDS=2.0
FEDERATION_OUTBOX_MAX_ATTEMPTS=6
FEDERATION_DEFAULT_POLICY_MODE=open
FEDERATION_ALLOW_DOMAINS=
FEDERATION_BLOCK_DOMAINS=
FEDERATION_DOMAIN_MAP=

# --- File Upload & Encrypted Blob Storage (Local Disk or S3/MinIO) ---
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET_NAME=relaychat-blobs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
UPLOAD_SIGNING_SECRET=change-me-upload-signing-secret-32-bytes
UPLOAD_URL_EXPIRE_SECONDS=1800
MAX_UPLOAD_BYTES=104857600
PER_USER_STORAGE_QUOTA_BYTES=524288000
CHUNK_SIZE_BYTES=1048576

# --- Rate Limiting, Hardening & CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_RATE_LIMIT_PER_MINUTE=25
API_RATE_LIMIT_PER_MINUTE=240
UPLOAD_RATE_LIMIT_PER_MINUTE=120
FEDERATION_RATE_LIMIT_PER_MINUTE=180
WS_MSG_RATE_LIMIT_PER_MINUTE=180
CSP_ENABLED=true
STRICT_FRAME_HEADERS=false
FILE_SCANNER_ENABLED=true
FILE_SCANNER_CMD=
EXPIRY_CLEANUP_INTERVAL_SECONDS=30
STATUS_TTL_HOURS=24

# --- MySQL Backup Retention & Encryption ---
BACKUP_RETENTION_DAYS=14
BACKUP_PASSPHRASE=

# --- WebRTC STUN / TURN (coturn) ---
TURN_REALM=chatapp.in
TURN_SHARED_SECRET=relaychat_turn_shared_secret
NEXT_PUBLIC_STUN_URL=stun:localhost:3478
NEXT_PUBLIC_TURN_URL=turn:localhost:3478

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chatapp.in

# --- Frontend Public Config & Caddy Loopback Ports ---
NEXT_PUBLIC_APP_NAME=RelayChat
NEXT_PUBLIC_APP_DOMAIN=chatapp.in
BACKEND_INTERNAL_URL=http://api:8000
RELAYCHAT_WEB_PORT=3045
RELAYCHAT_API_PORT=8045
