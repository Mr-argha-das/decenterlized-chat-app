}

www.jobresultwale.com {
        redir https://jobresultwale.com{uri} permanent
}

api.jobresultwale.com {
        reverse_proxy 127.0.0.1:1337
}

erp.rsmemorialpublicschool.com {
        reverse_proxy 127.0.0.1:8011
}

kids-krish.rsmemorialpublicschool.com {
        reverse_proxy 127.0.0.1:8012
}

kids-thada.rsmemorialpublicschool.com {
        reverse_proxy 127.0.0.1:8013
}

loan.wecarehhcs.in {
        reverse_proxy 127.0.0.1:7800
}
