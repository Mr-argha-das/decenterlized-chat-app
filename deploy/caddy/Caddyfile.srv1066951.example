http://www.nexttogen.com {
        redir https://nexttogen.com{uri} permanent
}

# Main site (HTTPS auto)
nexttogen.com, www.nexttogen.com {
        # Security headers
        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "SAMEORIGIN"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "geolocation=(), microphone=(), camera=()"
                -Server
        }

        # Admin image uploads ke liye (max 10MB)
        request_body {
                max_size 10MB
        }

        # Compression
        encode zstd gzip

        # Reverse proxy → Next.js port 3000
        reverse_proxy 127.0.0.1:3030 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote}
                header_up X-Forwarded-Proto {scheme}
                header_up X-Forwarded-Port {server_port}
                header_up Connection {>Connection}
                header_up Upgrade {>Upgrade}
                transport http {
                        read_timeout 30s
                        write_timeout 30s
                }
        }

        # Logs
        log {
                output file /var/log/caddy/nexttogen.log {
                        roll_size 10MiB
                        roll_keep 10
                        roll_keep_for 720h
                }
                format json
        }
}

# ==============================================================================
# RelayChat Decentralized E2EE Messenger — chatone.duckdns.org
# Isolated on 127.0.0.1:3045 (Frontend) & 127.0.0.1:8045 (Backend + WS)
# ==============================================================================
chatone.duckdns.org {
        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=()"
                -Server
        }

        request_body {
                max_size 110MB
        }

        encode zstd gzip

        @metrics path /metrics
        respond @metrics "Forbidden" 403

        @relaychat_api {
                path /.well-known/chat-server
                path /federation/*
                path /ws*
                path /api/*
                path /auth/*
                path /users*
                path /contacts*
                path /blocks*
                path /conversations*
                path /messages*
                path /groups*
                path /attachments/*
                path /statuses*
                path /push*
                path /health
        }
        handle @relaychat_api {
                reverse_proxy 127.0.0.1:8045 {
                        header_up Host {host}
                        header_up X-Real-IP {remote_host}
                }
        }

        handle {
                reverse_proxy 127.0.0.1:3045 {
                        header_up Host {host}
                        header_up X-Real-IP {remote_host}
                }
        }

        log {
                output file /var/log/caddy/chatone.log {
                        roll_size 10MiB
                        roll_keep 10
                        roll_keep_for 720h
                }
                format json
        }
}
